---
import { services } from '../data/site';
---

<section id="servicios" class="dots-bg relative bg-ink px-4 py-24 text-cream md:px-8 md:py-32">
	<div class="mx-auto max-w-[1312px]">
		<div class="grid gap-6 md:grid-cols-[1.4fr_1fr] md:items-end">
			<div>
				<p class="kicker" data-reveal>[ Lo que hacemos ]</p>
				<h2 class="mt-4 font-display text-[clamp(1.9rem,5.5vw,4.5rem)] leading-[0.95] uppercase">
					<span class="block" data-wipe>De la idea</span>
					<span class="block" data-wipe style="--d:1">a internet<span class="text-orange">.</span></span>
				</h2>
			</div>
			<p class="max-w-sm text-cream/70 md:justify-self-end" data-reveal style="--d:2">
				Diseñamos y construimos productos digitales con personalidad, velocidad y un propósito de negocio claro.
			</p>
		</div>

		<ul class="mt-16 border-t border-cream/15">
			{
				services.map((s, i) => (
					<li class="service group border-b border-cream/15" data-reveal style={`--d:${i}`}>
						<div class="relative grid items-center gap-3 overflow-hidden py-7 md:grid-cols-[4rem_1.2fr_1.6fr_3rem] md:gap-8 md:py-9">
							<span class="absolute inset-0 -z-0 origin-left scale-x-0 bg-orange transition-transform duration-500 ease-out group-hover:scale-x-100" />
							<span class="relative font-mono text-xs text-orange transition-colors group-hover:text-ink">0{i + 1}</span>
							<h3 class="relative font-display text-2xl uppercase transition-transform duration-300 group-hover:translate-x-3 md:text-3xl">
								{s.title}
							</h3>
							<div class="relative">
								<p class="text-sm leading-relaxed text-cream/70 transition-colors group-hover:text-cream">{s.body}</p>
								<p class="mt-2 font-pixel text-lg text-lime transition-colors group-hover:text-ink">$ 3k {s.cmd}</p>
							</div>
							<span class="relative hidden text-2xl transition-transform duration-300 group-hover:rotate-45 md:block">↗</span>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
