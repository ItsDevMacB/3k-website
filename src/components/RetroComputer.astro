---
import { Image } from 'astro:assets';
import computer from '../assets/retro-computer.png';
---

<div
	class="retro relative mx-auto aspect-square w-full max-w-[440px] select-none sm:max-w-[480px] lg:max-w-[560px]"
	data-retro
>
	<!-- Chips flotantes alrededor -->
	<span class="chip chip-a" aria-hidden="true">&lt;/&gt;</span>
	<span class="chip chip-b" aria-hidden="true">✦</span>
	<span class="chip chip-c" aria-hidden="true">.exe</span>
	<span class="chip chip-d" aria-hidden="true">♥ 3K</span>

	<div class="retro-float absolute inset-0">
		<button
			type="button"
			class="retro-tilt absolute inset-0 cursor-pointer"
			aria-label="Computadora retro de 3K. Haz clic para un mensaje secreto"
			data-retro-tilt
		>
			<Image
				src={computer}
				alt=""
				width={1024}
				height={1024}
				loading="eager"
				fetchpriority="high"
				class="pointer-events-none absolute inset-0 size-full drop-shadow-[0_30px_40px_rgb(16_16_16/0.18)]"
			/>

			<!-- Pantalla CRT encima de la imagen -->
			<div class="screen" data-screen aria-hidden="true">
				<div class="screen-content" data-screen-content>
					<div class="screen-bar"><span>3K_OS v2.6</span><span>▢ ✕</span></div>
					<pre class="screen-text" data-screen-text></pre>
				</div>
				<div class="screen-scan"></div>
				<div class="screen-glare"></div>
			</div>

			<!-- LED de encendido -->
			<span class="led" aria-hidden="true"></span>
		</button>
	</div>

	<div class="retro-shadow" aria-hidden="true"></div>
</div>

<style>
	.retro {
		perspective: 1200px;
	}
	.retro-float {
		animation: float 6s ease-in-out infinite;
	}
	.retro-tilt {
		transform-style: preserve-3d;
		transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.retro-tilt.is-glitch {
		animation: glitch 0.45s steps(2) both;
	}
	.retro-shadow {
		position: absolute;
		left: 18%;
		right: 14%;
		bottom: 9%;
		height: 6%;
		z-index: -1;
		border-radius: 50%;
		background: radial-gradient(closest-side, rgb(16 16 16 / 0.28), transparent);
		animation: shadow 6s ease-in-out infinite;
	}

	/* Coordenadas del cristal sobre la imagen de 1024×1024 */
	.screen {
		position: absolute;
		left: 30.4%;
		top: 22.6%;
		width: 32.4%;
		height: 31.4%;
		border-radius: 9% / 11%;
		overflow: hidden;
		background: radial-gradient(120% 100% at 50% 45%, #1c1f1c 0%, #121412 60%, #0a0b0a 100%);
		box-shadow:
			inset 0 0 28px rgb(0 0 0 / 0.9),
			inset 0 0 4px rgb(0 0 0 / 1);
		transform-origin: center;
		animation: power-on 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) 0.4s both;
	}
	.screen-content {
		position: absolute;
		inset: 0;
		padding: 7% 9%;
		text-align: left;
		color: var(--color-cream);
		font-family: var(--font-pixel);
		font-size: clamp(11px, 3.3cqw, 20px);
		line-height: 1.05;
		text-shadow:
			0 0 2px rgb(244 243 239 / 0.9),
			0 0 9px rgb(255 160 90 / 0.55);
		animation: flicker 4s infinite steps(1);
	}
	.retro {
		container-type: inline-size;
	}
	.screen-bar {
		display: flex;
		justify-content: space-between;
		opacity: 0.55;
		font-size: 0.8em;
		margin-bottom: 0.35em;
	}
	.screen-text {
		margin: 0;
		font: inherit;
		white-space: pre-wrap;
		word-break: break-word;
	}
	.screen-text :global(.cursor) {
		display: inline-block;
		width: 0.55em;
		height: 0.95em;
		vertical-align: -0.12em;
		background: currentColor;
		animation: blink 1s steps(1) infinite;
	}
	.screen-text :global(.hl) {
		color: var(--color-orange);
	}
	.screen-text :global(.ok) {
		color: var(--color-lime);
	}
	.screen-scan {
		position: absolute;
		inset: 0;
		background:
			repeating-linear-gradient(0deg, rgb(0 0 0 / 0.28) 0 1px, transparent 1px 3px),
			linear-gradient(180deg, transparent 0%, rgb(255 255 255 / 0.05) 50%, transparent 100%);
		background-size:
			100% 100%,
			100% 30%;
		background-repeat: repeat, no-repeat;
		animation: scan 5s linear infinite;
		pointer-events: none;
	}
	.screen-glare {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(70% 45% at 30% 15%, rgb(255 255 255 / 0.13), transparent 70%),
			radial-gradient(130% 120% at 50% 50%, transparent 55%, rgb(0 0 0 / 0.65) 100%);
		pointer-events: none;
	}

	.led {
		position: absolute;
		left: 35.4%;
		top: 57.3%;
		width: 3%;
		height: 3%;
		border-radius: 50%;
		background: radial-gradient(circle at 40% 35%, #ffb27a, #ff4d00 55%, transparent 72%);
		box-shadow: 0 0 14px 4px rgb(255 92 0 / 0.7);
		animation: led 2.4s ease-in-out infinite;
	}

	.chip {
		position: absolute;
		z-index: 2;
		padding: 0.3rem 0.65rem;
		border: 2px solid var(--color-ink);
		border-radius: 0.5rem;
		font-family: var(--font-pixel);
		font-size: 1.25rem;
		line-height: 1;
		box-shadow: var(--shadow-pixel-sm);
		animation: drift 7s ease-in-out infinite;
	}
	.chip-a {
		top: 10%;
		left: 4%;
		background: var(--color-lime);
		--r: -8deg;
	}
	.chip-b {
		top: 4%;
		right: 14%;
		background: var(--color-orange);
		color: var(--color-cream);
		animation-delay: -2s;
		--r: 10deg;
	}
	.chip-c {
		bottom: 26%;
		left: -2%;
		background: var(--color-cream);
		animation-delay: -4s;
		--r: 6deg;
	}
	.chip-d {
		bottom: 18%;
		right: 0%;
		background: var(--color-ink);
		color: var(--color-lime);
		animation-delay: -1s;
		--r: -6deg;
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-16px);
		}
	}
	@keyframes shadow {
		0%,
		100% {
			transform: scale(1);
			opacity: 1;
		}
		50% {
			transform: scale(0.85);
			opacity: 0.65;
		}
	}
	@keyframes drift {
		0%,
		100% {
			transform: translate(0, 0) rotate(var(--r));
		}
		50% {
			transform: translate(6px, -12px) rotate(calc(var(--r) * -1));
		}
	}
	@keyframes power-on {
		0% {
			filter: brightness(0);
			clip-path: inset(49.5% 0 49.5% 0);
		}
		35% {
			filter: brightness(3);
			clip-path: inset(49.5% 0 49.5% 0);
		}
		60% {
			filter: brightness(1.8);
			clip-path: inset(0 0 0 0);
		}
		100% {
			filter: brightness(1);
			clip-path: inset(0 0 0 0);
		}
	}
	@keyframes flicker {
		0%,
		100% {
			opacity: 1;
		}
		47% {
			opacity: 0.92;
		}
		48% {
			opacity: 1;
		}
		82% {
			opacity: 0.85;
		}
		83% {
			opacity: 1;
		}
	}
	@keyframes scan {
		from {
			background-position:
				0 0,
				0 -40%;
		}
		to {
			background-position:
				0 0,
				0 140%;
		}
	}
	@keyframes led {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.35;
		}
	}
	@keyframes glitch {
		0% {
			transform: translate(0) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
			filter: none;
		}
		25% {
			transform: translate(-6px, 2px) skewX(3deg);
			filter: hue-rotate(40deg) saturate(1.6);
		}
		50% {
			transform: translate(5px, -3px) skewX(-4deg);
			filter: hue-rotate(-30deg) contrast(1.4);
		}
		75% {
			transform: translate(-3px, 0);
			filter: invert(0.1);
		}
		100% {
			transform: translate(0) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
			filter: none;
		}
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
</style>

<script>
	type Line = string;

	const root = document.querySelector<HTMLElement>('[data-retro]');
	const tilt = root?.querySelector<HTMLElement>('[data-retro-tilt]');
	const out = root?.querySelector<HTMLElement>('[data-screen-text]');
	const reduced =
		window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
		document.documentElement.classList.contains('is-static');

	const scripts: Line[][] = [
		['> 3K_', 'CREATIVE SYSTEM READY.'],
		['> build --web', 'compilando...', '[██████░░] 80%', '<ok>✓ listo</ok>'],
		['> whoami', 'M · B · O', '<hl>3 personas</hl>', '<hl>1 estudio</hl>'],
		['> deploy --puebla', 'conectando...', '<ok>✓ en línea</ok>'],
		['> cafe --status', '[■■■] lleno', 'demasiadas ideas.'],
	];
	const secrets: Line[][] = [
		['> ¡hey! me tocaste', '<hl>¿un proyecto?</hl>', 'escríbenos ↓'],
		['> sudo make-it-pop', '<ok>✓ concedido</ok>'],
		['> ERROR 404', 'aburrimiento', 'no encontrado'],
	];

	const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
	// Convierte <hl>..</hl> y <ok>..</ok> en spans con clase
	const toHtml = (s: string) =>
		s
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/&lt;(hl|ok)>/g, '<span class="$1">')
			.replace(/&lt;\/(hl|ok)>/g, '</span>');

	let token = 0;
	let typed = '';

	const render = (html: string) => {
		if (out) out.innerHTML = html + '<span class="cursor"></span>';
	};

	async function play(lines: Line[], id: number) {
		let html = '';
		for (const line of lines) {
			const plain = line.replace(/<\/?(hl|ok)>/g, '');
			const tag = line.match(/^<(hl|ok)>/)?.[1];
			for (let i = 1; i <= plain.length; i++) {
				if (id !== token) return;
				const part = toHtml(plain.slice(0, i));
				render(html + (tag ? `<span class="${tag}">${part}</span>` : part));
				await sleep(plain[i - 1] === ' ' ? 20 : 38 + Math.random() * 40);
			}
			html += toHtml(line) + '\n';
			render(html);
			await sleep(260);
		}
	}

	async function loop() {
		const id = ++token;
		await sleep(1500); // espera a que se encienda la pantalla
		let i = 0;
		while (id === token) {
			await play(scripts[i % scripts.length], id);
			if (id !== token) return;
			await sleep(2600);
			i++;
		}
	}

	if (out) {
		if (reduced) {
			out.innerHTML = toHtml(scripts[0].join('\n')) + '\n';
		} else {
			loop();
		}
	}

	// Clic: glitch + mensaje secreto
	let secret = 0;
	tilt?.addEventListener('click', async () => {
		tilt.classList.remove('is-glitch');
		void tilt.offsetWidth;
		tilt.classList.add('is-glitch');
		const id = ++token;
		await play(secrets[secret++ % secrets.length], id);
		if (id !== token) return;
		await sleep(2400);
		if (id === token) loop();
	});

	// Escribe en el teclado real y aparece en la pantalla
	let typingTimer: number | undefined;
	let heroVisible = true;
	if (root) {
		new IntersectionObserver(([e]) => (heroVisible = e.isIntersecting)).observe(root);
	}
	window.addEventListener('keydown', (e) => {
		if (!heroVisible || e.metaKey || e.ctrlKey || e.altKey) return;
		const target = e.target as HTMLElement;
		if (target.closest('input, textarea, [contenteditable]')) return;
		const printable = e.key.length === 1 && e.key !== ' ';
		// Solo empieza a capturar con una letra, para no secuestrar espacio/enter
		if (!typed && !printable) return;
		if (printable || e.key === ' ' || e.key === 'Backspace' || e.key === 'Enter') {
			if (!typed) ++token; // pausa la animación automática
			if (e.key === ' ') {
				if (document.activeElement !== document.body) return;
				e.preventDefault();
				typed += ' ';
			} else if (e.key === 'Backspace') typed = typed.slice(0, -1);
			else if (e.key === 'Enter') typed += '\n> ';
			else typed += e.key;
			typed = typed.slice(-80);
			render(toHtml('> ' + typed));
			window.clearTimeout(typingTimer);
			typingTimer = window.setTimeout(() => {
				typed = '';
				loop();
			}, 3500);
		}
	});

	// Inclinación 3D siguiendo el cursor
	if (root && tilt && !reduced && window.matchMedia('(pointer: fine)').matches) {
		const hero = root.closest('section') ?? root;
		hero.addEventListener('pointermove', (e) => {
			const r = root.getBoundingClientRect();
			const x = ((e as PointerEvent).clientX - (r.left + r.width / 2)) / r.width;
			const y = ((e as PointerEvent).clientY - (r.top + r.height / 2)) / r.height;
			tilt.style.setProperty('--ry', `${Math.max(-1, Math.min(1, x)) * 14}deg`);
			tilt.style.setProperty('--rx', `${Math.max(-1, Math.min(1, y)) * -10}deg`);
		});
		hero.addEventListener('pointerleave', () => {
			tilt.style.setProperty('--ry', '0deg');
			tilt.style.setProperty('--rx', '0deg');
		});
	}
</script>
