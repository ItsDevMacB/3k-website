---
import { Image } from 'astro:assets';
import { projects } from '../data/site';

const tones = {
	orange: { frame: 'bg-orange', screen: 'bg-cream', accent: 'bg-orange' },
	stone: { frame: 'bg-stone', screen: 'bg-cream', accent: 'bg-ink' },
	lime: { frame: 'bg-lime', screen: 'bg-cream', accent: 'bg-lime' },
	ink: { frame: 'bg-ink', screen: 'bg-cream', accent: 'bg-orange' },
};
---

<section id="trabajo" class="px-4 py-24 md:px-8 md:py-32">
	<div class="mx-auto max-w-[1312px]">
		<div class="grid gap-6 md:grid-cols-[1.4fr_1fr] md:items-end">
			<div>
				<p class="kicker" data-reveal>[ Trabajo seleccionado ]</p>
				<h2 class="mt-4 font-display text-[clamp(1.9rem,5.5vw,4.5rem)] leading-[0.95] uppercase">
					<span class="block" data-wipe>Proyectos</span>
					<span class="block" data-wipe style="--d:1">que nos enorgullecen<span class="text-orange">.</span></span>
				</h2>
			</div>
			<p class="max-w-sm text-ink/75 md:justify-self-end" data-reveal style="--d:2">
				Una selección de sitios y productos donde la estrategia, el diseño y el desarrollo se encuentran.
			</p>
		</div>

		<div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-x-12">
			{
				projects.map((p, i) => {
					const t = tones[p.tone];
					return (
						<article class:list={['project group', i % 2 === 1 && 'md:mt-24']} data-reveal style={`--d:${i % 2}`}>
							<div class="window transition-transform duration-300 group-hover:-translate-y-2 group-hover:-rotate-1">
								<div class="window-bar">
									<span class="flex items-center gap-2">
										<span class="inline-block size-2.5 rounded-sm bg-orange" />
										{p.file}
									</span>
									<span class="tracking-widest">_ ▢ ✕</span>
								</div>

								<div class:list={['relative p-5 md:p-7', t.frame]}>
									<div class:list={['window aspect-[16/10] !shadow-none', t.screen]}>
										<div class="flex h-5 items-center gap-1.5 border-b-2 border-ink bg-ink px-2">
											<span class="size-1.5 rounded-full bg-orange" />
											<span class="size-1.5 rounded-full bg-lime" />
											<span class="size-1.5 rounded-full bg-cream" />
										</div>
										<div class="relative h-[calc(100%-1.25rem)] overflow-hidden">
											<Image
												src={p.image}
												alt={`Vista del proyecto ${p.name}`}
												widths={[480, 800, 1264]}
												sizes="(min-width: 768px) 600px, 90vw"
												class="size-full object-cover transition-transform duration-500 group-hover:scale-105"
											/>
											<span
												class:list={[
													'absolute top-3 left-3 rounded-md border-2 border-ink px-2.5 py-1 font-display text-sm uppercase shadow-[var(--shadow-pixel-sm)] md:text-base',
													t.accent,
													p.tone === 'stone' ? 'text-cream' : 'text-ink',
												]}
											>
												{p.name}
											</span>
											<span class="pointer-events-none absolute inset-0 translate-y-full bg-ink/90 p-5 font-pixel text-xl leading-tight text-lime transition-transform duration-300 group-hover:translate-y-0 md:p-7 md:text-2xl">
												&gt; {p.description}
												<span class="ml-1 inline-block h-5 w-2.5 animate-blink bg-lime align-middle" />
											</span>
										</div>
									</div>
								</div>

								<div class="flex items-end justify-between gap-4 border-t-2 border-ink bg-cream px-5 py-4">
									<div>
										<p class="font-mono text-[10px] text-orange">0{i + 1}</p>
										<h3 class="text-lg font-bold">{p.name}</h3>
										<p class="text-xs text-ink/60">{p.tags}</p>
									</div>
									<span class="flex size-10 items-center justify-center rounded-full border-2 border-ink text-lg transition-all group-hover:rotate-45 group-hover:bg-orange group-hover:text-cream">
										↗
									</span>
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</section>
