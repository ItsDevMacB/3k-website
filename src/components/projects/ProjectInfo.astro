---
import { Image } from 'astro:assets';
import type { Project } from '../../data/site';

interface Props {
	project: Project;
	slug: string;
	index: number;
	active?: boolean;
}

const { project, slug, index, active = false } = Astro.props;

const tones = {
	orange: 'var(--color-orange)',
	stone: 'var(--color-stone)',
	lime: 'var(--color-lime)',
};
const zoomIcon = 'M1 1h4v2H3v2H1zM7 1h4v4H9V3H7zM1 7h2v2h2v2H1zM9 7h2v4H7V9h2z';
---

<article
	class="info"
	id={`proyecto-${slug}`}
	aria-labelledby={`proyecto-${slug}-title`}
	data-info={index}
	data-active={active ? '' : undefined}
	style={`--tone:${tones[project.tone]}`}
>
	<h3 id={`proyecto-${slug}-title`} class="font-display text-[clamp(1.5rem,2.4vw,2.125rem)] leading-[1.05] uppercase">
		{project.name}
	</h3>
	<p class="leading-relaxed text-ink/80">{project.description}</p>
	<div class="info-foot">
		<dl class="grid gap-3 border-t-2 border-dashed border-ink/25 pt-4 font-mono text-sm">
			<div class="flex flex-wrap items-center justify-between gap-2">
				<dt class="text-ink/75">Tipo</dt>
				<dd class="font-bold">{project.tags}</dd>
			</div>
		</dl>
		<div class="js-only flex">
			<button type="button" class="btn btn-ghost px-5 py-3" data-act="zoom" aria-haspopup="dialog">
				<svg class="size-3 fill-current" viewBox="0 0 12 12" aria-hidden="true"><path d={zoomIcon}></path></svg>
				Ampliar
			</button>
		</div>
	</div>
	<!-- Sin JS la consola solo muestra el primer proyecto: las otras fichas traen su captura principal.
	     En <noscript> para que con JS (aunque esté oculta) nunca se descargue. -->
	{
		!active && (
			<noscript>
				<figure class="nojs-shot">
					<Image
						src={project.image}
						alt={project.imageAlt}
						widths={[480, 800]}
						sizes="(min-width: 1180px) 30vw, 90vw"
						loading="lazy"
						decoding="async"
						class="w-full rounded-md border-2 border-ink"
					/>
				</figure>
			</noscript>
		)
	}
</article>

<style>
	/* Franja del tono por gradiente dentro del borde ink (tono 6 px, ink 2 px): se ve también con lima y stone */
	.info {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		border: 2px solid var(--color-ink);
		border-radius: 0.75rem;
		background: linear-gradient(to bottom, var(--tone) 0 6px, var(--color-ink) 6px 8px, var(--color-cream) 8px);
		padding: 1.75rem 1.25rem 1.25rem;
		box-shadow: var(--shadow-pixel);
	}
	@media (min-width: 768px) {
		.info {
			padding: 2rem 1.5rem 1.5rem;
		}
	}
	/* Tipo y «Ampliar» van al pie: con la ficha estirada hasta el escritorio, el aire queda en medio */
	.info-foot {
		display: grid;
		gap: 1.25rem;
		margin-top: auto;
	}

	.nojs-shot {
		margin: 0;
	}

	:global(#trabajo:not([data-ready])) .js-only {
		display: none;
	}
</style>
