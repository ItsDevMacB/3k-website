---
import type { Project } from '../../data/site';

interface Props {
	project: Project;
	slug: string;
	index: number;
	active?: boolean;
}

const { project, slug, index, active = false } = Astro.props;

const fills = {
	orange: 'var(--color-orange)',
	stone: 'var(--color-stone)',
	lime: 'var(--color-lime)',
};
---

<a
	href={`#proyecto-${slug}`}
	id={`disk-${slug}`}
	class="floppy"
	style={`--disk:${fills[project.tone]}`}
	data-disk={index}
	data-active={active ? '' : undefined}
>
	<span class="floppy-body">
		<!-- Disquete 3½″ de frente: esquina recortada, obturador metálico, etiqueta y seguro -->
		<svg class="floppy-art" viewBox="0 0 90 94" aria-hidden="true" data-disk-art>
			<path class="floppy-shell" d="M2 2H81L88 9V92H2Z"></path>
			<rect class="floppy-shutter" x="24" y="2" width="44" height="29"></rect>
			<rect class="floppy-window" x="51" y="8" width="9" height="17"></rect>
			<rect class="floppy-label" x="11" y="40" width="68" height="48"></rect>
			<rect class="floppy-lock" x="4" y="80" width="5" height="7"></rect>
		</svg>
		<span class="floppy-name">{project.name}</span>
	</span>
	<span class="floppy-state" aria-hidden="true">En unidad</span>
</a>

<style>
	.floppy {
		position: relative;
		display: block;
		width: 100%;
		max-width: 8.5rem;
		min-height: 2.75rem;
		border-radius: 0.375rem;
		color: var(--color-ink);
		text-decoration: none;
		transition: transform 160ms cubic-bezier(0.23, 1, 0.32, 1);
	}
	.floppy-body {
		position: relative;
		display: block;
		aspect-ratio: 90 / 94;
	}
	.floppy-art {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
		filter: drop-shadow(3px 3px 0 var(--color-ink));
	}
	.floppy-art * {
		stroke: var(--color-ink);
		stroke-width: 2px;
		vector-effect: non-scaling-stroke;
		stroke-linejoin: round;
	}
	.floppy-shell {
		fill: var(--disk);
	}
	.floppy-shutter {
		fill: var(--color-stone);
		shape-rendering: crispEdges;
	}
	.floppy-window {
		fill: var(--color-ink);
		shape-rendering: crispEdges;
	}
	.floppy-label {
		fill: var(--color-cream);
		shape-rendering: crispEdges;
	}
	.floppy-lock {
		fill: var(--color-ink);
		shape-rendering: crispEdges;
	}

	/* Texto de la etiqueta, encima del rectángulo crema del SVG */
	.floppy-name {
		position: absolute;
		top: 44%;
		left: 13%;
		width: 74%;
		height: 48%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding-inline: 0.125rem;
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.01em;
		text-align: center;
		hyphens: manual;
	}
	@media (max-width: 479px) {
		.floppy-name {
			font-size: 0.75rem;
		}
	}

	.floppy-state {
		position: absolute;
		top: -0.625rem;
		left: 50%;
		translate: -50% 0;
		display: none;
		border: 2px solid var(--color-ink);
		border-radius: 0.25rem;
		background: var(--color-lime);
		padding: 0.125rem 0.375rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.2;
		white-space: nowrap;
	}

	/* Disquete en la unidad: queda su hueco en la fila, con el nombre y la marca «En unidad» */
	:global(#trabajo[data-ready]) .floppy[data-active] .floppy-art {
		filter: none;
	}
	:global(#trabajo[data-ready]) .floppy[data-active] .floppy-shell {
		fill: color-mix(in srgb, var(--color-ink) 6%, transparent);
	}
	:global(#trabajo[data-ready]) .floppy[data-active] :is(.floppy-shutter, .floppy-window, .floppy-lock) {
		opacity: 0;
	}
	:global(#trabajo[data-ready]) .floppy[data-active] .floppy-label {
		fill: transparent;
		stroke-dasharray: 3 3;
	}
	:global(#trabajo[data-ready]) .floppy[data-active] .floppy-state {
		display: block;
	}

	@media (hover: hover) and (pointer: fine) {
		.floppy:not([data-active]):hover {
			transform: translateY(-3px);
		}
	}
	.floppy:not([data-active]):active {
		transform: scale(0.97);
	}
	.floppy:focus-visible {
		outline-offset: 6px;
	}

	@media (prefers-reduced-motion: reduce) {
		.floppy:hover,
		.floppy:active {
			transform: none !important;
		}
	}
</style>
