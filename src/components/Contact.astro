---
import { contact, socials, whatsappLink } from '../data/site';
import Instagram from '../assets/icons/instagram.svg';
import Facebook from '../assets/icons/facebook.svg';
import Tiktok from '../assets/icons/tiktok.svg';

const icons = { instagram: Instagram, facebook: Facebook, tiktok: Tiktok };
const year = new Date().getFullYear();
---

<footer
	id="contacto"
	class="relative overflow-hidden bg-orange px-4 pt-24 pb-8 text-ink md:px-8 md:pt-32"
	data-nav-bg="orange"
>
	<!-- Pixeles decorativos -->
	<div class="pixels pointer-events-none absolute inset-0" aria-hidden="true">
		{Array.from({ length: 14 }).map((_, i) => <span style={`--i:${i}`} />)}
	</div>

	<div class="relative mx-auto max-w-[1312px]">
		<p class="font-mono text-[11px] font-bold tracking-[0.14em] uppercase" data-reveal>[ ¿Tienes una idea? ]</p>

		<h2 class="mt-6 font-display text-[clamp(2rem,8.6vw,8.5rem)] leading-[0.9] text-cream uppercase">
			<span class="block" data-wipe>Construyamos</span>
			<span class="block" data-wipe style="--d:1">algo<span class="text-ink">.</span></span>
		</h2>

		<div class="mt-12 grid gap-10 lg:grid-cols-[1fr_420px] lg:items-end">
			<p class="max-w-md text-lg leading-relaxed" data-reveal>
				Cuéntanos qué tienes en mente: una landing, una tienda, un sistema o solo una idea a medio cocinar. Te
				respondemos con una propuesta clara y sin letras chiquitas.
			</p>

			<div class="window bg-ink text-cream" data-reveal="pop" style="--d:1" data-nav-bg="dark">
				<div class="window-bar !bg-cream !text-ink"><span>contacto.exe</span><span>▢ ✕</span></div>
				<div class="space-y-4 p-6 font-pixel text-xl leading-tight">
					<p><span class="text-lime">&gt;</span> respuesta en menos de 24 h</p>
					<p><span class="text-lime">&gt;</span> {contact.email}</p>
					<a
						href={whatsappLink()}
						target="_blank"
						rel="noopener"
						class="btn btn-primary w-full justify-center font-mono"
					>
						Escribir por WhatsApp ↗
					</a>
					<a
						href={`mailto:${contact.email}`}
						class="btn w-full justify-center border-cream bg-transparent font-mono text-cream shadow-none hover:shadow-none"
					>
						Enviar correo
					</a>
				</div>
			</div>
		</div>

		<!-- Barra de tareas retro -->
		<div class="taskbar mt-24 font-mono text-[11px] font-bold tracking-widest uppercase">
			<a href="#top" class="task-btn task-start inline-flex">
				<span class="grid size-5 place-items-center rounded-sm bg-orange font-display text-[10px] text-ink">3K</span>
				Inicio
			</a>
			<span class="task-btn hidden sm:inline-flex" aria-hidden="true">▣ 3k_studio.exe</span>
			<span class="task-btn hidden lg:inline-flex" aria-hidden="true">▣ contacto.exe</span>

			<p class="mx-auto hidden px-3 md:block">3K© / {contact.location} / {year}</p>

			<div class="task-tray">
				<ul class="flex gap-3">
					{
						socials.map((s) => {
							const Icon = icons[s.icon];
							return (
								<li>
									<a
										href={s.href}
										target="_blank"
										rel="noopener"
										aria-label={s.label}
										class="block transition-transform hover:-translate-y-0.5 hover:text-orange"
									>
										<Icon width={20} height={20} aria-hidden="true" />
									</a>
								</li>
							);
						})
					}
				</ul>
				<span class="flex items-center gap-1.5" title="Sistema en línea">
					<span class="inline-block size-2 animate-blink rounded-full bg-lime ring-2 ring-ink"></span>
					<span class="hidden sm:inline">en línea</span>
				</span>
				<time class="font-pixel text-lg leading-none tracking-normal" data-clock>--:--</time>
			</div>
		</div>
		<p class="mt-4 text-center font-pixel text-lg text-ink/60 md:hidden">3K© / {contact.location} / {year}</p>
		<p class="mt-3 hidden text-center font-pixel text-base text-ink/50 md:block">↑ ↑ ↓ ↓ ← → ← → B A</p>
	</div>
</footer>

<script>
	const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
	if (clock) {
		const tick = () => {
			const d = new Date();
			clock.textContent = d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', hour12: false });
			clock.dateTime = d.toISOString();
		};
		tick();
		setInterval(tick, 15000);
	}
</script>

<style>
	.taskbar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem;
		background: var(--color-cream);
		border: 2px solid var(--color-ink);
		border-radius: 0.6rem;
		box-shadow: var(--shadow-pixel-sm);
	}
	.task-btn {
		/* display va en clases de Tailwind para poder ocultarlos por breakpoint */
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.75rem;
		border: 2px solid var(--color-ink);
		border-radius: 0.4rem;
		background: var(--color-cream);
		box-shadow:
			inset -2px -2px 0 var(--color-stone),
			inset 2px 2px 0 #fff;
		white-space: nowrap;
	}
	.task-start {
		background: var(--color-lime);
		box-shadow:
			inset -2px -2px 0 rgb(0 0 0 / 0.2),
			inset 2px 2px 0 rgb(255 255 255 / 0.6);
	}
	.task-start:active {
		box-shadow: inset 2px 2px 0 rgb(0 0 0 / 0.25);
	}
	.task-tray {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding: 0.35rem 0.75rem;
		border: 2px solid var(--color-ink);
		border-radius: 0.4rem;
		box-shadow: inset 2px 2px 0 var(--color-stone);
	}

	.pixels span {
		position: absolute;
		left: calc(var(--i) * 7.3%);
		bottom: -40px;
		width: 18px;
		height: 18px;
		background: var(--color-ink);
		opacity: 0.12;
		animation: rise calc(9s + var(--i) * 0.7s) linear infinite;
		animation-delay: calc(var(--i) * -1.3s);
	}
	.pixels span:nth-child(3n) {
		background: var(--color-cream);
		opacity: 0.25;
		width: 12px;
		height: 12px;
	}
	@keyframes rise {
		to {
			transform: translateY(-900px) rotate(180deg);
		}
	}
</style>
