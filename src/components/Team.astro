---
import { team } from '../data/site';

const tones = {
	orange: 'bg-orange text-cream',
	lime: 'bg-lime text-ink',
	cream: 'bg-cream text-ink',
};
---

<section id="equipo" class="px-4 py-24 md:px-8 md:py-32">
	<div class="mx-auto max-w-[1312px] rounded-[2rem] border-2 border-ink bg-stone p-6 shadow-[var(--shadow-pixel)] md:p-14">
		<div class="grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:items-center">
			<div>
				<p class="kicker" data-reveal>[ Las personas detrás de 3K ]</p>
				<h2 class="mt-4 font-display text-[clamp(1.9rem,5vw,4.25rem)] leading-[0.95] uppercase">
					<span class="block" data-wipe>03 personas.</span>
					<span class="block" data-wipe style="--d:1">01 estudio.</span>
					<span class="block text-orange" data-wipe style="--d:2">Demasiadas ideas.</span>
				</h2>
			</div>

			<div>
				<p class="max-w-md text-ink/75" data-reveal>
					Somos un equipo freelance compacto de Puebla que combina desarrollo, diseño y pensamiento de producto.
					Lo bastante pequeños para estar cerca de cada detalle; lo bastante técnicos para construir lo que imaginas.
				</p>

				<ul class="mt-8 grid grid-cols-3 gap-3 md:gap-5">
					{
						team.map((m, i) => (
							<li class="player group" data-reveal="pop" style={`--d:${i + 1}`}>
								<div class="player-inner">
									<div class:list={['player-face window flex aspect-square items-center justify-center', tones[m.tone]]}>
										<span class="boil font-display text-5xl md:text-7xl" style={`--r:${(i - 1) * 3}deg`}>{m.initial}</span>
									</div>
									<div class="player-face player-back window flex aspect-square flex-col justify-between bg-ink p-3 font-pixel text-lime md:p-4">
										<span class="text-sm leading-none text-cream/60 md:text-base">P{i + 1} · LVL 99</span>
										<span class="text-xl leading-none md:text-2xl">{m.stat}</span>
										<span class="block h-2 w-full rounded-sm bg-lime/20">
											<span class="block h-full w-full rounded-sm bg-lime" />
										</span>
									</div>
								</div>
								<p class="mt-3 font-mono text-[11px] font-bold tracking-wider uppercase">{m.name}</p>
								<p class="font-mono text-[10px] tracking-wider text-ink/60 uppercase">{m.role}</p>
							</li>
						))
					}
				</ul>
				<p class="mt-4 font-pixel text-lg text-ink/60" data-reveal>&gt; pasa el cursor para ver sus stats</p>
			</div>
		</div>
	</div>
</section>

<style>
	.player {
		perspective: 800px;
	}
	.player-inner {
		position: relative;
		transform-style: preserve-3d;
		transition: transform 0.6s cubic-bezier(0.3, 1.4, 0.5, 1);
	}
	.player:hover .player-inner,
	.player:focus-within .player-inner {
		transform: rotateY(180deg);
	}
	.player-face {
		backface-visibility: hidden;
	}
	.player-back {
		position: absolute;
		inset: 0;
		transform: rotateY(180deg);
	}
</style>
